# ---------------------------------------------------------------------------
# Indonesia Tour Guide — environment variables
# Copy to .env.local for development. NEVER commit real values.
# Every variable is optional for local development; production values below
# marked REQUIRED must be set on the hosting platform (Vercel project
# settings → Environment Variables), not in Git.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
# Public origin of the site (canonical URLs, OG links, same-origin checks).
# REQUIRED in production.
NEXT_PUBLIC_SITE_URL=https://indonesiatourguide.com

# Secret used to sign session cookies (HMAC-SHA256). Generate with:
#   openssl rand -hex 48
# If unset, a random secret is generated and stored in the settings table —
# sessions then reset when the database is recreated. REQUIRED in production.
AUTH_SECRET=

# SQLite database file location. Default: data/itg.sqlite
# In production point this at a persistent volume (see docs/backup.md).
DATABASE_PATH=

# --- Payments --------------------------------------------------------------
# Provider used at checkout: sandbox | midtrans | bank_transfer
# Production default (when unset): bank_transfer. Development: sandbox.
PAYMENT_PROVIDER=

# Shared secret for payment webhook signature verification.
# Keep stable across restarts — changing it invalidates in-flight webhooks.
# Falls back to AUTH_SECRET, then a DB-stored random secret. REQUIRED in
# production when using a real gateway.
PAYMENT_WEBHOOK_SECRET=

# Midtrans Snap credentials (https://dashboard.midtrans.com).
# Server key stays server-side only; never expose it to the browser.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# "true" (default) = sandbox environment, "false" = production.
MIDTRANS_SANDBOX=true

# --- Email (transactional) -------------------------------------------------
# Without SMTP settings, emails are rendered and queued in the email_outbox
# table but not delivered (visible to admins under the email log).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- WhatsApp --------------------------------------------------------------
# Full international number, digits only (e.g. 6281234567890).
# Default: number stored in settings (editable in Admin → Settings).
WHATSAPP_NUMBER=

# --- Analytics (optional) --------------------------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
